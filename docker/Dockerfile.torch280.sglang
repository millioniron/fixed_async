FROM docker.gh-proxy.com/nvcr.io/nvidia/pytorch:25.06-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_CONSTRAINT=""
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV CUDA_HOME=/usr/local/cuda

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=pypi.org
ARG PIP_TIMEOUT=300

RUN pip uninstall -y torch torchvision torchaudio torchao torch-tensorrt pytorch-triton transformer-engine \
    opencv opencv-python opencv-python-headless flash-attn

COPY docker/torch-2.8.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl /tmp/wheels/
COPY docker/torchvision-0.23.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl /tmp/wheels/
COPY docker/torchaudio-2.8.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl /tmp/wheels/

RUN pip install --no-deps --timeout ${PIP_TIMEOUT} \
    /tmp/wheels/torch-2.8.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl \
    /tmp/wheels/torchvision-0.23.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl \
    /tmp/wheels/torchaudio-2.8.0+cu129-cp312-cp312-manylinux_2_28_x86_64.whl && \
    rm -rf /tmp/wheels

RUN apt-get update && apt-get install -y zip openjdk-21-jdk && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

WORKDIR /build
COPY . .

RUN pip install --trusted-host ${PIP_TRUSTED_HOST} --index-url ${PIP_INDEX_URL} --timeout ${PIP_TIMEOUT} \
    -r requirements_torch280_sglang.txt

RUN pip uninstall -y flash-attn opencv opencv-python opencv-python-headless && \
    pip install --no-build-isolation \
    --trusted-host ${PIP_TRUSTED_HOST} \
    --index-url ${PIP_INDEX_URL} \
    --timeout ${PIP_TIMEOUT} \
    "flash-attn==2.7.4.post1" "opencv-python-headless==4.11.0.86"

RUN rm -rf /build
WORKDIR /workspace
